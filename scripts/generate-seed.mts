/**
 * Writes supabase/seed.sql from src/config/catalogue.ts.
 * Run with: npm run db:seed
 */
import { writeFileSync } from "node:fs";
import { categories, products } from "../src/config/catalogue.ts";

const q = (s: string) => `'${s.replaceAll("'", "''")}'`;
const lines: string[] = [
  "-- GENERATED by scripts/generate-seed.ts from src/config/catalogue.ts — do not edit by hand.",
  "begin;",
];

for (const c of categories) {
  lines.push(
    `insert into public.categories (slug, name, sort_order, is_active) values (${q(c.slug)}, ${q(c.name)}, ${c.sortOrder}, ${c.isActive})` +
      ` on conflict (slug) do update set name = excluded.name, sort_order = excluded.sort_order, is_active = excluded.is_active;`,
  );
}

products.forEach((p, i) => {
  const features = `array[${p.features.map(q).join(", ")}]::text[]`;
  lines.push(
    `insert into public.products (slug, name, description, features, ai_generation_allowance, is_from_price, sort_order)` +
      ` values (${q(p.slug)}, ${q(p.name)}, ${q(p.description)}, ${features}, ${p.aiGenerationAllowance}, ${!!p.isFromPrice}, ${i + 1})` +
      ` on conflict (slug) do update set name = excluded.name, description = excluded.description, features = excluded.features,` +
      ` ai_generation_allowance = excluded.ai_generation_allowance, is_from_price = excluded.is_from_price, sort_order = excluded.sort_order;`,
  );
  for (const [currency, amount] of Object.entries(p.prices)) {
    // Retire a changed price, then insert the new active one (keeps history).
    lines.push(
      `update public.prices set is_active = false where product_id = (select id from public.products where slug = ${q(p.slug)})` +
        ` and currency = ${q(currency)} and is_active and unit_amount <> ${amount};`,
      `insert into public.prices (product_id, currency, unit_amount) select id, ${q(currency)}, ${amount} from public.products where slug = ${q(p.slug)}` +
        ` and not exists (select 1 from public.prices pr where pr.product_id = products.id and pr.currency = ${q(currency)} and pr.is_active);`,
    );
  }
});

lines.push("commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log(`seed.sql written: ${categories.length} categories, ${products.length} products`);
