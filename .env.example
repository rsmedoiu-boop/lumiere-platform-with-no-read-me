# Copy to .env.local. Never commit real keys.
# Local development: run `npx supabase start` (free, Docker) and paste the values it prints.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by webhooks/exports in later milestones.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (test mode) — Milestone 4
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend — Milestone 5
RESEND_API_KEY=
# Higgsfield API — Milestone 7, only after spend is approved
HIGGSFIELD_API_KEY=

# Local testing only: lets a production build run without the service key. Never set in deployment.
# LOCAL_ALLOW_NO_RATE_LIMIT=1
